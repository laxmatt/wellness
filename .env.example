# Copy to .env.local for local development. .env* is gitignored: never commit a key.
#
# The assistant is OPTIONAL. With no key set, the site runs in full and the
# assistant replies come from a scripted stand-in that is labelled as such in
# the UI. Browsing, filtering, product pages and comparison never depend on it.

# Required only to run the assistant against a live model.
OPENAI_API_KEY=

# Optional. Defaults shown.
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Spend controls, enforced by this application before every model call.
# ASSISTANT_MONTHLY_CAP_USD=25
# ASSISTANT_SESSION_TURN_LIMIT=20

# Token prices in dollars per million tokens. VERIFY THESE against the
# provider's current price list: they are a planning assumption, not a quote,
# and the monthly cap is only as accurate as these two numbers.
# ASSISTANT_INPUT_USD_PER_MTOK=0.15
# ASSISTANT_OUTPUT_USD_PER_MTOK=0.6

# Shared ledger. Required before a live model is allowed to run: without it the
# assistant refuses to spend, because each instance would enforce its own cap.
DATABASE_URL=

# Operator-only usage endpoint at /api/admin/assistant-usage.
ADMIN_ACCESS_KEY=

# Set to 1 once the token prices above have been checked against the provider's
# current price list. Reported by the admin endpoint.
# ASSISTANT_PRICES_VERIFIED=0

# Local development only, on one machine: allows a live model to run against
# the in-process ledger. Never set this in a deployed environment.
# ASSISTANT_ALLOW_UNSHARED_LEDGER=0

# Per-connection rate limit. The session id comes from the browser and is
# changeable, so it is a convenience limit; this one is keyed on the client
# address and is what actually bounds a single abuser.
# ASSISTANT_CLIENT_HOURLY_LIMIT=30

# REQUIRED for a live model. At least 16 characters, private, generated by you:
#   openssl rand -hex 24
# The client address is hashed with this before it reaches the ledger, so no
# readable IP is stored. There is no built-in default: a value in the source
# would make every stored hash reversible. Changing it resets hourly counts.
ASSISTANT_CLIENT_SALT=

# Which header carries the real client address. Leave unset on Vercel, which
# overwrites x-forwarded-for and is detected automatically. Behind Cloudflare
# use cf-connecting-ip. Behind your own nginx use x-real-ip, but ONLY if your
# config sets it from the socket rather than passing through what arrived.
# Naming a header your edge merely forwards configures a bypass, not a limit.
# Without this (and without Vercel) a live model will not run.
# ASSISTANT_TRUSTED_IP_HEADER=

# Local development only, on one machine: run a live model with every caller in
# one rate-limit bucket, because localhost has no edge to identify them.
# Never set this in a deployed environment.
# ASSISTANT_ALLOW_UNIDENTIFIED_CLIENTS=0

# Request bounds. MAX_OUTPUT_TOKENS is sent to the provider as max_tokens and is
# a real cap. MAX_INPUT_TOKENS is checked against our own character-based
# estimate of the prompt, so it bounds the estimate, not the provider's count.
# ASSISTANT_MAX_INPUT_TOKENS=6000
# ASSISTANT_MAX_OUTPUT_TOKENS=500
# ASSISTANT_TIMEOUT_MS=20000

# Margin applied to each reservation, to absorb the gap between our token
# estimate and the provider's own count. 1.3 = reserve 30 percent more. A
# margin, not a guarantee: set a hard spend limit at the provider as well.
# ASSISTANT_ESTIMATE_SAFETY_FACTOR=1.3
