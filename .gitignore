# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# assistant usage ledger (prototype file store)
/.data

# The example file holds no values, only names and comments.
!.env.example

# private live-test diagnostics: rejected model output, never committed
/.diagnostics

# local preview catalogue: invented products staged from a sample supplier
# file, an operator's working directory. Never committed and never deployed.
/catalog-preview
